<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCBManufacturing.PresentationLogic.ViewModels"
        xmlns:local="using:PCBManufacturing.AvaloniaApp"
        x:Class="PCBManufacturing.AvaloniaApp.MainWindow"
        x:DataType="vm:MainViewModel"
        Title=""
        Icon="{x:Static local:AppIcons.Window}"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.App}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <ContentControl Content="{Binding ., x:CompileBindings=False}"/>
</Window>
