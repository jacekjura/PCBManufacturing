<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCBManufacturing.ViewModels"
             xmlns:views="using:PCBManufacturing.AvaloniaApp.Views"
             xmlns:conv="using:PCBManufacturing.AvaloniaApp.Converters"
             x:Class="PCBManufacturing.AvaloniaApp.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:GeometryConverter x:Key="GeometryConverter"/>
        <SolidColorBrush x:Key="Brush.Success" Color="#0F7B0F"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PCBManufacturing.Avalonia/Styles/AppStyles.axaml"/>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:MainViewModel">
            <views:MainView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PreferencesViewModel">
            <views:PreferencesView/>
        </DataTemplate>
        <DataTemplate DataType="vm:QuoteViewModel">
            <views:QuoteView/>
        </DataTemplate>
        <DataTemplate DataType="vm:OrderViewModel">
            <views:OrderView/>
        </DataTemplate>
    </Application.DataTemplates>
</Application>
