<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCBManufacturing.ViewModels"
             xmlns:views="using:PCBManufacturing.AvaloniaApp.Views"
             xmlns:conv="using:PCBManufacturing.AvaloniaApp.Converters"
             x:Class="PCBManufacturing.AvaloniaApp.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:GeometryConverter x:Key="GeometryConverter"/>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Brush.App" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Brush.CardAlt" Color="#F7F7F7"/>
                    <SolidColorBrush x:Key="Brush.Stroke" Color="#E1E1E1"/>
                    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5D5D5D"/>
                    <SolidColorBrush x:Key="Brush.Accent" Color="#0067C0"/>
                    <SolidColorBrush x:Key="Brush.AccentHover" Color="#005AAB"/>
                    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#004E96"/>
                    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#E8F2FB"/>
                    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Brush.Hover" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="Brush.Error" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="Brush.ErrorSubtle" Color="#FDECEC"/>
                    <SolidColorBrush x:Key="Brush.Success" Color="#0F7B0F"/>
                    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#E8F6E8"/>
                    <SolidColorBrush x:Key="Brush.Preview" Color="#E6E6E6"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Brush.App" Color="#1C1C1C"/>
                    <SolidColorBrush x:Key="Brush.Card" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="Brush.CardAlt" Color="#323232"/>
                    <SolidColorBrush x:Key="Brush.Stroke" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="Brush.Accent" Color="#4CC2FF"/>
                    <SolidColorBrush x:Key="Brush.AccentHover" Color="#76D0FF"/>
                    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#9ADFFF"/>
                    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#123447"/>
                    <SolidColorBrush x:Key="Brush.OnAccent" Color="#06202C"/>
                    <SolidColorBrush x:Key="Brush.Input" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="Brush.Hover" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="Brush.Error" Color="#FF6B6B"/>
                    <SolidColorBrush x:Key="Brush.ErrorSubtle" Color="#3D2424"/>
                    <SolidColorBrush x:Key="Brush.Success" Color="#6CCB5F"/>
                    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#1E3A22"/>
                    <SolidColorBrush x:Key="Brush.Preview" Color="#141414"/>

                    <!-- Fluent keeps these light-theme values in the dark palette. -->
                    <SolidColorBrush x:Key="SystemControlErrorTextForegroundBrush" Color="#FF6B6B"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#323232"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1C1C1C"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#767676"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#333333"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#323232"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#767676"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#5A5A5A"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#C8C8C8"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PCBManufacturing.Avalonia/Styles/AppStyles.axaml"/>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:MainViewModel">
            <views:MainView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PreferencesViewModel">
            <views:PreferencesView/>
        </DataTemplate>
        <DataTemplate DataType="vm:QuoteViewModel">
            <views:QuoteView/>
        </DataTemplate>
        <DataTemplate DataType="vm:OrderViewModel">
            <views:OrderView/>
        </DataTemplate>
    </Application.DataTemplates>
</Application>
