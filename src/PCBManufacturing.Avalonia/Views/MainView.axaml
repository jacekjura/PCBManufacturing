<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCBManufacturing.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:local="using:PCBManufacturing.AvaloniaApp.Markup"
             x:Class="PCBManufacturing.AvaloniaApp.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="Root"
             Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,16,24,8">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SystemControlHighlightListLowBrush}">
                    <ic:SymbolIcon Classes="icon" Symbol="{local:Icon Logo}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundAccentBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="{Binding Localization[App.Title]}"/>
                    <TextBlock Classes="caption" Text="{Binding Localization[App.Subtitle]}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SystemControlBackgroundAccentBrush}" IsVisible="{Binding IsDirty}"/>
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Brush.Success}" IsVisible="{Binding !IsDirty}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="caption" Margin="0,0,8,0"/>
                <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" CornerRadius="8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Language" Content="EN" IsChecked="{Binding IsEnglish}" Padding="12,6"/>
                        <RadioButton GroupName="Language" Content="RU" IsChecked="{Binding IsRussian}" Padding="12,6"/>
                    </StackPanel>
                </Border>
                <Button Command="{Binding ToggleThemeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Classes="icon" Symbol="{local:Icon Sun}" IsVisible="{Binding !IsDark}" FontSize="14"/>
                        <ic:SymbolIcon Classes="icon" Symbol="{local:Icon Moon}" IconVariant="Filled" IsVisible="{Binding IsDark}" FontSize="14"/>
                        <TextBlock Text="{Binding Localization[Action.Theme]}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Classes="icon" Symbol="{local:Icon Save}" FontSize="14"/>
                        <TextBlock Text="{Binding Localization[Action.Save]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding PlaceOrderCommand}" MinWidth="148" Content="{Binding Order.PlaceOrderText}"/>
            </StackPanel>
        </Grid>
        <ProgressBar Grid.Row="1" Height="3" Margin="0,10,0,0" IsIndeterminate="True" IsVisible="{Binding Order.IsBusy}"/>
        <Grid x:Name="Sections" Grid.Row="2" Margin="0,12,0,8">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Expander Grid.Row="0" Classes="section" IsExpanded="{Binding IsPreferencesExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Tab.Preferences]}">
                <Expander.Header>
                    <TextBlock Text="{Binding Localization[Tab.Preferences]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <ContentControl Content="{Binding Preferences}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Expander>
            <Expander Grid.Row="1" Classes="section" IsExpanded="{Binding IsQuoteExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Tab.Quote]}">
                <Expander.Header>
                    <TextBlock Text="{Binding Localization[Tab.Quote]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <ContentControl Content="{Binding Quote}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Expander>
            <Expander Grid.Row="2" Classes="section" IsExpanded="{Binding IsOrdersExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Tab.Order]}">
                <Expander.Header>
                    <TextBlock Text="{Binding Localization[Tab.Order]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <ContentControl Content="{Binding Order}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
