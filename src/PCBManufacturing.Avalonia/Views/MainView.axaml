<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCBManufacturing.ViewModels"
             xmlns:local="using:PCBManufacturing.AvaloniaApp.Markup"
             x:Class="PCBManufacturing.AvaloniaApp.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="Root"
             Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,16,24,8">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SystemControlHighlightListLowBrush}">
                    <Path Classes="icon" Data="{local:Icon Logo}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource SystemControlForegroundAccentBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="{Binding Localization[App.Title]}"/>
                    <TextBlock Classes="caption" Text="{Binding Localization[App.Subtitle]}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SystemControlBackgroundAccentBrush}" IsVisible="{Binding IsDirty}"/>
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Brush.Success}" IsVisible="{Binding !IsDirty}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="caption" Margin="0,0,8,0"/>
                <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" CornerRadius="8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Language" Content="EN" IsChecked="{Binding IsEnglish}" Padding="12,6"/>
                        <RadioButton GroupName="Language" Content="RU" IsChecked="{Binding IsRussian}" Padding="12,6"/>
                    </StackPanel>
                </Border>
                <Button Command="{Binding ToggleThemeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Data="{local:Icon Sun}" IsVisible="{Binding !IsDark}" Width="14" Height="14"/>
                        <Path Classes="icon" Data="{local:Icon Moon}" IsVisible="{Binding IsDark}" Width="14" Height="14" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="0"/>
                        <TextBlock Text="{Binding Localization[Action.Theme]}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Data="{local:Icon Save}" Width="14" Height="14"/>
                        <TextBlock Text="{Binding Localization[Action.Save]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding PlaceOrderCommand}" MinWidth="148" Content="{Binding Order.PlaceOrderText}"/>
            </StackPanel>
        </Grid>
        <ProgressBar Grid.Row="1" Height="3" Margin="0,10,0,0" IsIndeterminate="True" IsVisible="{Binding Order.IsBusy}"/>
        <TabControl Grid.Row="2" Margin="0,8,0,0" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Data="{local:Icon Preferences}" Width="15" Height="15"/>
                        <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).Localization[Tab.Preferences]}"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Preferences}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Data="{local:Icon Quote}" Width="15" Height="15"/>
                        <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).Localization[Tab.Quote]}"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Quote}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Data="{local:Icon Order}" Width="15" Height="15"/>
                        <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).Localization[Tab.Order]}"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Order}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
