<Window x:Class="PCBManufacturing.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:PCBManufacturing.Wpf.Behaviors"
        xmlns:conv="clr-namespace:PCBManufacturing.Wpf.Converters"
        xmlns:markup="clr-namespace:PCBManufacturing.Wpf.Markup"
        xmlns:views="clr-namespace:PCBManufacturing.Wpf.Views"
        Title="{Binding Localization[App.Title]}"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        Background="{DynamicResource Brush.App}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource Brush.TextPrimary}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        behaviors:WindowTheme.Theme="{Binding Theme}">
    <Window.Resources>
        <conv:BindingProxy x:Key="SectionProxy" Data="{Binding}"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,16,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="{markup:Icon Logo}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding Localization[App.Title]}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Localization[App.Subtitle]}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,0"/>
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="EN" GroupName="Language" IsChecked="{Binding IsEnglish, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Action.Language]}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="RU" GroupName="Language" IsChecked="{Binding IsRussian, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
                <Button Margin="0,0,8,0" MinWidth="96" Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="{Binding Localization[Action.Theme]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="14" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="{markup:Icon Sun}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Theme}" Value="Dark">
                                            <Setter Property="Text" Value="{markup:Icon Moon}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Localization[Action.Theme]}"/>
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Command="{Binding SaveCommand}" AutomationProperties.Name="{Binding Localization[Action.Save]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{markup:Icon Save}" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Localization[Action.Save]}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlaceOrderCommand}" MinWidth="148" Content="{Binding Order.PlaceOrderText}"/>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" Height="3" Margin="24,8,24,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Accent}" IsIndeterminate="True" Visibility="{Binding Order.IsBusy, Converter={StaticResource BoolToVisibility}}"/>

        <Grid Grid.Row="2" Margin="24,12,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding Data.IsPreferencesExpanded, Source={StaticResource SectionProxy}, Converter={StaticResource BoolToGridLength}}"/>
                <RowDefinition Height="{Binding Data.IsQuoteExpanded, Source={StaticResource SectionProxy}, Converter={StaticResource BoolToGridLength}}"/>
                <RowDefinition Height="{Binding Data.IsOrdersExpanded, Source={StaticResource SectionProxy}, Converter={StaticResource BoolToGridLength}}"/>
            </Grid.RowDefinitions>
            <Expander Grid.Row="0" IsExpanded="{Binding IsPreferencesExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Tab.Preferences]}">
                <Expander.Header>
                    <TextBlock Text="{Binding Localization[Tab.Preferences]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <views:PreferencesView Validation.ErrorTemplate="{x:Null}">
                    <views:PreferencesView.DataContext>
                        <Binding Path="Preferences" ValidatesOnNotifyDataErrors="False"/>
                    </views:PreferencesView.DataContext>
                </views:PreferencesView>
            </Expander>
            <Expander Grid.Row="1" IsExpanded="{Binding IsQuoteExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Tab.Quote]}">
                <Expander.Header>
                    <TextBlock Text="{Binding Localization[Tab.Quote]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <views:QuoteView DataContext="{Binding Quote}"/>
            </Expander>
            <Expander Grid.Row="2" IsExpanded="{Binding IsOrdersExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[Tab.Order]}">
                <Expander.Header>
                    <TextBlock Text="{Binding Localization[Tab.Order]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <views:OrderView DataContext="{Binding Order}"/>
            </Expander>
        </Grid>
    </Grid>
</Window>
