<UserControl x:Class="PCBManufacturing.Wpf.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PCBManufacturing.Wpf.Behaviors"
             xmlns:markup="clr-namespace:PCBManufacturing.Wpf.Markup"
             behaviors:FadeIn.IsEnabled="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionText}" Text="{Binding Text[Order.Heading]}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Text[Order.Intro]}" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding ValidationMessages}" Margin="0,0,0,12" Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Error}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Summary.Project]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Preferences.SummaryProject}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Summary.Postcode]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Preferences.SummaryPostcode}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Summary.Material]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Preferences.SummaryMaterial}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Quote.Legend.Size]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quote.LegendSize}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Quote.Legend.Layers]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quote.LegendLayers}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Quote.Legend.Finish]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quote.LegendFinish}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Quote.Total]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quote.TotalText}" FontWeight="SemiBold" FontSize="18"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text[Quote.Lead]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quote.LeadText}" FontWeight="SemiBold"/>
                </Grid>

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlaceOrderCommand}" HorizontalAlignment="Left" MinWidth="180" AutomationProperties.Name="{Binding Text[Order.Place]}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Margin="0,0,8,0" Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="2" StrokeDashArray="3 2" RenderTransformOrigin="0.5,0.5" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="Spinner"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding PlaceOrderText}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionText}" Text="{Binding Text[Order.History]}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="{markup:Icon Order}" Style="{StaticResource Icon}" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,12"/>
                    <TextBlock Text="{Binding Text[Order.EmptyTitle]}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Text[Order.EmptyBody]}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top" Fill="{Binding MaskHex, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource Brush.Stroke}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
