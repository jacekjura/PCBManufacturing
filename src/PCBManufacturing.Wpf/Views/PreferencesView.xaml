<UserControl x:Class="PCBManufacturing.Wpf.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PCBManufacturing.Wpf.Behaviors"
             behaviors:FadeIn.IsEnabled="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource SectionText}" Text="{Binding Text[Preferences.Heading]}" Margin="0"/>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Text[Preferences.Intro]}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Project]}"/>
                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text[Field.Project]}"/>
                        <TextBlock Text="{Binding ProjectMessage}" Foreground="{DynamicResource Brush.Error}" FontSize="12" Margin="2,4,0,12" TextWrapping="Wrap" Visibility="{Binding HasProjectError, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Postcode]}"/>
                        <TextBox Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text[Field.Postcode]}"/>
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Text[Field.Postcode.Hint]}" Margin="2,4,0,0"/>
                        <TextBlock Text="{Binding PostcodeMessage}" Foreground="{DynamicResource Brush.Error}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap" Visibility="{Binding HasPostcodeError, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding SummaryPostcodeState}" Foreground="{DynamicResource Brush.Success}" FontSize="12" Margin="2,4,0,12" Visibility="{Binding IsPostcodeValid, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Material]}"/>
                        <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" ItemTemplate="{StaticResource OptionTemplate}" AutomationProperties.Name="{Binding Text[Field.Material]}"/>
                        <TextBlock Text="{Binding SelectedMaterial.Impact}" Style="{StaticResource CaptionText}" Margin="2,6,0,12"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Mask]}"/>
                        <ComboBox ItemsSource="{Binding SolderMaskColors}" SelectedItem="{Binding SelectedSolderMask}" ItemTemplate="{StaticResource OptionTemplate}" AutomationProperties.Name="{Binding Text[Field.Mask]}"/>
                        <StackPanel Orientation="Horizontal" Margin="2,6,0,12">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding MaskHex, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource Brush.Stroke}" StrokeThickness="1"/>
                            <TextBlock Text="{Binding SummaryMask}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Thickness]}"/>
                        <ComboBox ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding SelectedThickness}" ItemTemplate="{StaticResource OptionTemplate}" AutomationProperties.Name="{Binding Text[Field.Thickness]}"/>
                        <TextBlock Text="{Binding SelectedThickness.Impact}" Style="{StaticResource CaptionText}" Margin="2,6,0,12"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Quantity]}"/>
                        <ComboBox ItemsSource="{Binding Quantities}" SelectedItem="{Binding SelectedQuantity}" ItemTemplate="{StaticResource OptionTemplate}" AutomationProperties.Name="{Binding Text[Field.Quantity]}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Text[Field.Notes]}" Margin="2,16,0,6"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Text[Field.Notes]}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{Binding Text[Summary.Title]}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Project]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SummaryProject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Postcode]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SummaryPostcode}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SummaryPostcodeState}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPostcodeValid}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Material]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SummaryMaterial}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SummaryModifier}" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Lead]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SummaryLead}" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Mask]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding MaskHex, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource Brush.Stroke}"/>
                                <TextBlock Text="{Binding SummaryMask}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Thickness]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SummaryThickness}" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Summary.Quantity]}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SummaryQuantity}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding Text[Action.Discard]}" Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Text[Action.Continue]}" Command="{Binding DataContext.ContinueCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
    </Grid>
</UserControl>
